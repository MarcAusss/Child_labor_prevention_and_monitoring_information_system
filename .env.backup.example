# CLPMIS Phase 7B backup settings

CLPMIS_BACKUP_DISK=local
CLPMIS_BACKUP_DIRECTORY=backups
CLPMIS_BACKUP_RETENTION_DAYS=30

# Use command names when MySQL is in PATH:
CLPMIS_MYSQLDUMP_PATH=mysqldump
CLPMIS_MYSQL_PATH=mysql

# XAMPP examples:
# CLPMIS_MYSQLDUMP_PATH="C:\xampp\mysql\bin\mysqldump.exe"
# CLPMIS_MYSQL_PATH="C:\xampp\mysql\bin\mysql.exe"

# Automatic scheduling remains disabled until the server scheduler is configured.
CLPMIS_SCHEDULED_BACKUP_ENABLED=false
CLPMIS_SCHEDULED_BACKUP_TIME=01:30
CLPMIS_SCHEDULED_BACKUP_CLEANUP_ENABLED=false
