# CLPMIS Phase 7A security settings

CLPMIS_IDLE_TIMEOUT_MINUTES=30

CLPMIS_PASSWORD_MIN_LENGTH=10
CLPMIS_PASSWORD_REQUIRE_LETTERS=true
CLPMIS_PASSWORD_REQUIRE_MIXED_CASE=true
CLPMIS_PASSWORD_REQUIRE_NUMBERS=true
CLPMIS_PASSWORD_REQUIRE_SYMBOLS=true

CLPMIS_X_FRAME_OPTIONS=DENY
CLPMIS_REFERRER_POLICY=strict-origin-when-cross-origin
CLPMIS_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=(), usb=()"

# Keep disabled until the production asset policy has been tested.
CLPMIS_CSP_ENABLED=false

# Production recommendations:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example
# SESSION_DRIVER=database
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
